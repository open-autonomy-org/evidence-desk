{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/answer-library.schema.json",
  "title": "Reviewed answers kept for reuse (answers.json)",
  "type": "object",
  "required": [
    "schema",
    "answers"
  ],
  "properties": {
    "schema": {
      "const": "evidence-desk.answer-library/1"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answer",
          "sources",
          "reviewed_by",
          "reviewed_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "reviewed_by": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
