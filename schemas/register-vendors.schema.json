{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/register-vendors.schema.json",
  "title": "Vendors register (registers/vendors.csv)",
  "description": "One row of the CSV register. Columns: id, name, service, data_access, criticality, assurance, last_review, owner. Unknown columns are kept.",
  "x-columns": [
    "id",
    "name",
    "service",
    "data_access",
    "criticality",
    "assurance",
    "last_review",
    "owner"
  ],
  "type": "object",
  "required": [
    "id",
    "name",
    "criticality"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string"
    },
    "data_access": {
      "type": "string"
    },
    "criticality": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "assurance": {
      "type": "string"
    },
    "last_review": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "owner": {
      "type": "string"
    }
  }
}
