{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/register-risks.schema.json",
  "title": "Risk register (registers/risks.csv)",
  "description": "One row of the CSV register. Columns: id, title, description, likelihood, impact, treatment, controls, owner, status, review_due. Unknown columns are kept.",
  "x-columns": [
    "id",
    "title",
    "description",
    "likelihood",
    "impact",
    "treatment",
    "controls",
    "owner",
    "status",
    "review_due"
  ],
  "type": "object",
  "required": [
    "id",
    "title",
    "likelihood",
    "impact",
    "treatment",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "likelihood": {
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    "impact": {
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    "treatment": {
      "enum": [
        "undecided",
        "mitigate",
        "accept",
        "transfer",
        "avoid"
      ]
    },
    "controls": {
      "type": "string",
      "description": "Control ids separated by semicolons."
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "treated",
        "closed"
      ]
    },
    "review_due": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    }
  }
}
