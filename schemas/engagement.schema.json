{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/engagement.schema.json",
  "title": "Audit engagement (audits/<id>/engagement.json)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "type",
    "firm",
    "status",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "evidence-desk.engagement/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "type": {
      "enum": [
        "type1",
        "type2"
      ]
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Type 1: the date the design is described as of."
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "description": "Type 2: the observation period."
    },
    "firm": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planning",
        "fieldwork",
        "reporting",
        "closed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
