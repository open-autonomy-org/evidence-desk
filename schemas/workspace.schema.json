{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/workspace.schema.json",
  "title": "Workspace manifest (evidence-desk.json)",
  "type": "object",
  "required": [
    "schema",
    "organization",
    "created_at",
    "frameworks"
  ],
  "properties": {
    "schema": {
      "const": "evidence-desk.workspace/1"
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "soc2, or the id of a catalog in catalog/frameworks/ (checked when the workspace is read)"
      },
      "contains": {
        "const": "soc2"
      },
      "description": "The frameworks the program targets. SOC 2 is always one (docs/decisions/0002-frameworks-are-targets.md)."
    }
  }
}
