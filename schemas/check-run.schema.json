{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/check-run.schema.json",
  "title": "One run of the enabled collectors and their checks (checks/runs/<id>.json)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "started_at",
    "finished_at",
    "by",
    "collectors",
    "results"
  ],
  "properties": {
    "schema": {
      "const": "evidence-desk.check-run/1"
    },
    "id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "by": {
      "type": "string"
    },
    "collectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "error": {
            "type": "string"
          },
          "snapshot": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "collector",
          "controls",
          "status",
          "detail"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "collector": {
            "type": "string"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "error"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
