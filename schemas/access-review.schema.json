{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/access-review.schema.json",
  "title": "Access review (reviews/access/<id>.json)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "system",
    "period",
    "reviewer",
    "listing",
    "accounts",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "evidence-desk.access-review/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "system": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "reviewer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "listing": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "generated_by"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generated_by": {
          "type": "string",
          "description": "How the user listing was produced, so its completeness can be checked."
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "account",
          "decision"
        ],
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1
          },
          "person": {
            "type": "string"
          },
          "privileged": {
            "type": "boolean"
          },
          "decision": {
            "enum": [
              "pending",
              "keep",
              "remove",
              "modify"
            ]
          },
          "note": {
            "type": "string"
          },
          "done_on": {
            "type": "string",
            "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
          }
        }
      }
    },
    "status": {
      "enum": [
        "open",
        "signed-off"
      ]
    },
    "signed_off_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
