{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/evidence.schema.json",
  "title": "Evidence record (evidence/records/<id>.json)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "controls",
    "source",
    "collected_at",
    "files",
    "recorded_by"
  ],
  "properties": {
    "schema": {
      "const": "evidence-desk.evidence/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "collector",
            "open-autonomy",
            "evidence-desk"
          ]
        },
        "name": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "How the evidence was generated, so a reviewer can reproduce it."
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer"
          }
        }
      }
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "The person this evidence is about (a registers/people.csv id), for per-person obligations."
    }
  }
}
