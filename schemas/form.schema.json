{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/form.schema.json",
  "title": "Form (forms/<id>.json): a quiz, survey or acknowledgment people complete",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "kind",
    "controls",
    "recurrence",
    "due_within_days",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": "evidence-desk.form/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "quiz",
        "survey",
        "acknowledgment"
      ]
    },
    "intro": {
      "type": "string"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "recurrence": {
      "enum": [
        "onboarding",
        "annual",
        "onboarding-and-annual"
      ]
    },
    "due_within_days": {
      "type": "integer",
      "description": "Days after a person's start date by which the first response is due."
    },
    "pass_score": {
      "type": "integer",
      "description": "For a quiz: the percentage of correct answers needed to pass."
    },
    "acknowledges_policies": {
      "type": "boolean",
      "description": "When true, a response records the approved version of every policy in force."
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "choice",
              "yes-no",
              "text",
              "attest"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct": {
            "type": "string",
            "description": "For a quiz choice question: the correct option."
          },
          "required_answer": {
            "type": "string",
            "description": "For an attestation or survey: the answer a passing response must give."
          }
        }
      }
    }
  }
}
