{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/register-vulnerabilities.schema.json",
  "title": "Vulnerability register (registers/vulnerabilities.csv)",
  "description": "One row of the CSV register. Columns: id, title, severity, system, source, found_on, due_on, fixed_on, owner. Unknown columns are kept.",
  "x-columns": [
    "id",
    "title",
    "severity",
    "system",
    "source",
    "found_on",
    "due_on",
    "fixed_on",
    "owner"
  ],
  "type": "object",
  "required": [
    "id",
    "title",
    "severity",
    "found_on",
    "due_on"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "system": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "found_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "due_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fixed_on": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
    },
    "owner": {
      "type": "string"
    }
  }
}
