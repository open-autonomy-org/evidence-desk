{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-autonomy-org/evidence-desk/schemas/audit-request.schema.json",
  "title": "Auditor request (audits/<id>/requests/<request>.json)",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "kind",
    "controls",
    "status",
    "evidence",
    "thread"
  ],
  "properties": {
    "schema": {
      "const": "evidence-desk.audit-request/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "document",
        "population",
        "sample"
      ]
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "open",
        "submitted",
        "accepted",
        "returned"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "population": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "For a sample request: the evidence record holding the population the samples were drawn from."
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "status"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "provided",
              "exception"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "thread": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "by",
          "side",
          "text"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "enum": [
              "client",
              "firm"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
