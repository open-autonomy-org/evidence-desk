{
  "id": "evidence-desk-fleet",
  "description": "One native executor; start.ts --container runs the credential valve and reporter on the host. Setup copies this definition beside the project and selects the existing Docker context.",
  "resources": {
    "memoryMiB": 3072,
    "writableStorageMiB": 16384
  },
  "services": [
    {
      "id": "executor",
      "type": "external",
      "external": {
        "up": [
          "docker",
          "run",
          "--init",
          "--detach",
          "--rm",
          "--name",
          "oa-evidence-desk",
          "--read-only",
          "--cap-drop",
          "ALL",
          "--security-opt",
          "no-new-privileges",
          "--pids-limit",
          "256",
          "--memory",
          "1536m",
          "--cpus",
          "2",
          "--tmpfs",
          "/tmp:rw,nosuid,nodev,size=268435456",
          "--mount",
          "type=volume,source=oa-evidence-desk-home,target=/opt/data",
          "--mount",
          "type=volume,source=oa-evidence-desk-repo,target=/work/project",
          "evidence-desk-agent:local"
        ],
        "down": [
          "sh",
          "-c",
          "if docker container inspect oa-evidence-desk >/dev/null 2>&1; then docker stop --time 15 oa-evidence-desk; fi"
        ],
        "status": [
          "docker",
          "inspect",
          "--format",
          "{{.State.Running}}",
          "oa-evidence-desk"
        ]
      }
    }
  ]
}
